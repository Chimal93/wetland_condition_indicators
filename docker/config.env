# Settings for the Docker-based runner (docker/run_indicators.sh, docker/run_script.sh).
#
# You normally do NOT edit this file. Every value below is a default that
# works for most people. To change a setting, pick ONE of these two ways:
#
#   (a) Permanently, for this machine: create the file docker/config.local.env
#       (same folder as this file) and put one "NAME=value" line per setting
#       you want to change. Only list the settings you change. Example file:
#
#           GJEN_SOURCE=AR50
#           RUNS_DIR=/data/wetland_runs
#
#       config.local.env is ignored by git, so your machine-specific paths
#       never end up in the repository.
#
#   (b) For a single run only: put the setting in front of the command,
#       for example
#
#           INDICATORS="GJEN" bash docker/run_indicators.sh
#
#       This wins over both config.local.env and this file for that run.
#
# Values with spaces need double quotes, as in INDICATORS="FUNC CONN".
# Do not put spaces around the "=" sign.


# ---------------------------------------------------------------------------
# RUNS_DIR - where each run writes its logs, recorded software versions,
# result snapshots and download caches.
#
# Default: the folder "runs" inside the repository, which git ignores. It is
# created if missing. If you move it, keep it on a local disk (not a network
# share).
#
#   In config.local.env:   RUNS_DIR=/data/wetland_runs
#   For one run:           RUNS_DIR=/data/wetland_runs bash docker/run_indicators.sh
# ---------------------------------------------------------------------------
RUNS_DIR="${RUNS_DIR:-${REPO_DIR:-.}/runs}"


# ---------------------------------------------------------------------------
# IMAGE - name of the Docker image built by docker/build_image.sh.
#
# Only change this if you build several images side by side (for example
# to compare R versions). build_image.sh and the run scripts must then use
# the same value, so set it in config.local.env rather than per command.
#
#   In config.local.env:   IMAGE=wetland-indicators:test
# ---------------------------------------------------------------------------
IMAGE="${IMAGE:-wetland-indicators:r4.6.1}"


# ---------------------------------------------------------------------------
# INDICATORS - which indicators run_indicators.sh runs, in this order,
# separated by spaces. Possible values: FUNC CONN GJEN
#   FUNC = NO_FUNC_003 (about a minute)
#   CONN = NO_CONN_001 (minutes with the published caches)
#   GJEN = NO_GJEN_001 (hours on a first run, minutes afterwards)
#
#   For one run, only NO_GJEN_001:      INDICATORS="GJEN" bash docker/run_indicators.sh
#   For one run, the two quick ones:    INDICATORS="FUNC CONN" bash docker/run_indicators.sh
#   In config.local.env:                INDICATORS="FUNC CONN"
# ---------------------------------------------------------------------------
INDICATORS="${INDICATORS:-FUNC CONN GJEN}"


# ---------------------------------------------------------------------------
# GJEN_SOURCE - where NO_GJEN_001 gets its forest and mire polygons from.
#   AR5  - detailed national land-resource map (FKB-AR5). This is what the
#          published results were built with, so it is the default. Access
#          to FKB-AR5 is restricted, and the two national layers must be
#          prepared once with docker/prepare_ar5_input/ (see docker/README.md).
#   AR50 - coarser public map, downloaded automatically. Needs no access, so
#          this is the sensible choice for anyone without FKB-AR5. Results
#          differ slightly from the AR5-based ones.
#
# If you do not have FKB-AR5, use AR50:
#
#   In config.local.env:   GJEN_SOURCE=AR50
#   For one run:           GJEN_SOURCE=AR50 bash docker/run_indicators.sh
# ---------------------------------------------------------------------------
GJEN_SOURCE="${GJEN_SOURCE:-AR5}"


# ---------------------------------------------------------------------------
# RERUN_FETCH - download steps are skipped when their output file already
# exists. Set to "yes" to download and rebuild everything again, for example
# after a source dataset was updated.
#
#   For one run:           RERUN_FETCH=yes bash docker/run_indicators.sh
# ---------------------------------------------------------------------------
RERUN_FETCH="${RERUN_FETCH:-no}"
