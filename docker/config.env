# Settings for the Docker-based runner (docker/run_indicators.sh, docker/run_script.sh).
#
# You normally do NOT edit this file. Every value below is a default that
# works for most people. To change a setting, pick ONE of these two ways:
#
#   (a) Permanently, for this machine: create the file docker/config.local.env
#       (same folder as this file) and put one "NAME=value" line per setting
#       you want to change. Only list the settings you change. Example file:
#
#           GJEN_SOURCE=AR50
#           RUNS_DIR=/data/wetland_runs
#
#       config.local.env is ignored by git, so your machine-specific paths
#       never end up in the repository.
#
#   (b) For a single run only: put the setting in front of the command,
#       for example
#
#           INDICATORS="GJEN" bash docker/run_indicators.sh
#
#       This wins over both config.local.env and this file for that run.
#
# Values with spaces need double quotes, as in INDICATORS="FUNC CONN".
# Do not put spaces around the "=" sign.


# ---------------------------------------------------------------------------
# RUNS_DIR - where each run writes its logs, recorded software versions,
# result snapshots and download caches.
#
# Default: the folder "runs" inside the repository, which git ignores. It is
# created if missing. If you move it, keep it on a local disk (not a network
# share).
#
#   In config.local.env:   RUNS_DIR=/data/wetland_runs
#   For one run:           RUNS_DIR=/data/wetland_runs bash docker/run_indicators.sh
# ---------------------------------------------------------------------------
RUNS_DIR="${RUNS_DIR:-${REPO_DIR:-.}/runs}"


# ---------------------------------------------------------------------------
# IMAGE - name of the Docker image built by docker/build_image.sh.
#
# Only change this if you build several images side by side (for example
# to compare R versions). build_image.sh and the run scripts must then use
# the same value, so set it in config.local.env rather than per command.
#
#   In config.local.env:   IMAGE=wetland-indicators:test
# ---------------------------------------------------------------------------
IMAGE="${IMAGE:-wetland-indicators:r4.6.1}"


# ---------------------------------------------------------------------------
# INDICATORS - which indicators run_indicators.sh runs, separated by
# spaces. Possible values: FUNC CONN GJEN2 NDVI GJEN
#   FUNC  = NO_FUNC_003 (about a minute)
#   CONN  = NO_CONN_003, mire-model variant (minutes with the published caches)
#   GJEN2 = NO_GJEN_002, from the committed canopy heights (minutes)
#   NDVI  = NO_NDVI_001 (provisional), from the committed MODIS series (minutes)
#   GJEN  = NO_GJEN_001 (hours on a first run, minutes afterwards)
# The AR5 variant of NO_CONN_003 and new NO_GJEN_002 canopy heights are
# separate, much longer runs with their own scripts (see docker/README.md).
#
#   For one run, only NO_GJEN_001:      INDICATORS="GJEN" bash docker/run_indicators.sh
#   For one run, the quick ones:        INDICATORS="FUNC CONN GJEN2 NDVI" bash docker/run_indicators.sh
#   In config.local.env:                INDICATORS="FUNC CONN"
# ---------------------------------------------------------------------------
INDICATORS="${INDICATORS:-FUNC CONN GJEN2 NDVI GJEN}"


# ---------------------------------------------------------------------------
# GJEN_SOURCE - where NO_GJEN_001 gets its forest and mire polygons from.
#   AR5  - detailed national land-resource map (FKB-AR5). This is what the
#          published results were built with, so it is the default. Access
#          to FKB-AR5 is restricted, and the two national layers must be
#          prepared once with docker/prepare_ar5_input/ (see docker/README.md).
#   AR50 - coarser public map, downloaded automatically. Needs no access, so
#          this is the sensible choice for anyone without FKB-AR5. Results
#          differ slightly from the AR5-based ones.
#
# If you do not have FKB-AR5, use AR50:
#
#   In config.local.env:   GJEN_SOURCE=AR50
#   For one run:           GJEN_SOURCE=AR50 bash docker/run_indicators.sh
# ---------------------------------------------------------------------------
GJEN_SOURCE="${GJEN_SOURCE:-AR5}"


# ---------------------------------------------------------------------------
# RERUN_FETCH - download steps are skipped when their output file already
# exists. Set to "yes" to download and rebuild everything again, for example
# after a source dataset was updated.
#
#   For one run:           RERUN_FETCH=yes bash docker/run_indicators.sh
# ---------------------------------------------------------------------------
RERUN_FETCH="${RERUN_FETCH:-no}"


# ===========================================================================
# NO_GJEN_002 canopy-height models. Only needed to compute new canopy heights
# from aerial photos; the deliverables are rebuilt from committed tables and
# need none of this. CHM_IMAGE, CHM_MODEL_DIR and ORTHOPHOTO_SOURCE_PATH serve
# both versions; the other settings in this block belong to version 000.003
# (docker/run_NO_GJEN_002_canopy_height_model.sh, superseded).
# ===========================================================================

# ---------------------------------------------------------------------------
# CHM_IMAGE - name of the image built by docker/build_canopy_height_image.sh
# (the R image plus the Python environment for the model).
# ---------------------------------------------------------------------------
CHM_IMAGE="${CHM_IMAGE:-wetland-indicators-chm:r4.6.1-py3.9}"


# ---------------------------------------------------------------------------
# CHM_MODEL_DIR - where docker/canopy_height_model/download_model_and_weights.sh
# keeps Meta's model code and weights (about 800 MB). Keep it on a local disk.
#
#   In config.local.env:   CHM_MODEL_DIR=/data/canopy_height_model
# ---------------------------------------------------------------------------
CHM_MODEL_DIR="${CHM_MODEL_DIR:-$RUNS_DIR/canopy_height_model}"


# ---------------------------------------------------------------------------
# ORTHOPHOTO_SOURCE_PATH - the RGB orthophoto the model reads: a GeoTIFF,
# Cloud-Optimised GeoTIFF or VRT, 8-bit RGB, 0.5 m or finer, ideally
# EPSG:25833. Either a local file (its folder is mounted read-only into the
# container) or a remote "/vsicurl/https://..." path. No default: it depends
# on what imagery you have access to, so set it in config.local.env.
# A remote source that needs a login also needs ORTHOPHOTO_SOURCE_USERPWD
# ("user:password"); put that in config.local.env too, never in this file.
#
#   In config.local.env:   ORTHOPHOTO_SOURCE_PATH=/mnt/g/imagery/ortho_50cm.tif
# ---------------------------------------------------------------------------
ORTHOPHOTO_SOURCE_PATH="${ORTHOPHOTO_SOURCE_PATH:-}"
ORTHOPHOTO_SOURCE_USERPWD="${ORTHOPHOTO_SOURCE_USERPWD:-}"


# ---------------------------------------------------------------------------
# ORTHOPHOTO_METADATA - files that describe the orthophoto: flight/project
# footprints, the list of source images, the supplier's metadata. Separate
# several paths with ":". Each file's checksum is recorded with every run,
# so a result can always be traced back to exactly this imagery. Optional,
# but strongly recommended for anything you want to compare over time.
#
#   In config.local.env:   ORTHOPHOTO_METADATA=/mnt/g/imagery/footprints.gpkg:/mnt/g/imagery/sources.txt
# ---------------------------------------------------------------------------
ORTHOPHOTO_METADATA="${ORTHOPHOTO_METADATA:-}"


# ---------------------------------------------------------------------------
# ORTHOPHOTO_VISIBLE_PROJECTS, ORTHOPHOTO_PROJECT_GRID - the mosaic's flight
# metadata, used to record WHEN the photo of each polygon was taken (a
# national mosaic mixes flights from many years and seasons). After the
# canopy heights are computed, NO_GJEN_002/R/assign_orthophoto_flight_dates.R
# writes orthophoto_flight_dates.csv next to them. Optional; leave empty to
# skip. Both files are also checksummed with the run.
#   VISIBLE_PROJECTS: one non-overlapping outline per flight project,
#                     showing where it is visible in the mosaic
#                     (Norge i bilder: mosaic_coverage_by_project.gpkg)
#   PROJECT_GRID:     the mosaic grid with flight dates per cell and project
#                     (Norge i bilder: layer mosaic_grid)
#
#   In config.local.env:   ORTHOPHOTO_VISIBLE_PROJECTS=/mnt/g/imagery/metadata/mosaic_coverage_by_project.gpkg
#                          ORTHOPHOTO_PROJECT_GRID=/mnt/g/imagery/metadata/mosaic_grid.gpkg
# ---------------------------------------------------------------------------
ORTHOPHOTO_VISIBLE_PROJECTS="${ORTHOPHOTO_VISIBLE_PROJECTS:-}"
ORTHOPHOTO_PROJECT_GRID="${ORTHOPHOTO_PROJECT_GRID:-}"


# ---------------------------------------------------------------------------
# CHM_RUN_NAME - name of the folder the per-polygon canopy heights are
# written to: NO_GJEN_002/data/OpenS_data/canopy_height_runs/<CHM_RUN_NAME>/.
# Rerunning with the same name resumes that run; a new name starts a new one.
# Use a name that says what the input was, e.g. the imagery and year.
#
#   For one run:           CHM_RUN_NAME=ortho2025_test20 bash docker/run_NO_GJEN_002_canopy_height_model.sh
# ---------------------------------------------------------------------------
CHM_RUN_NAME="${CHM_RUN_NAME:-}"


# ---------------------------------------------------------------------------
# CHM_REGIONS - which regions to process, in this order (smallest first, so
# problems show up early). CHM_MAX_POLYGONS caps the number of polygons per
# region for a quick test; 0 means all.
#
#   For a quick test:      CHM_REGIONS=Vestlandet CHM_MAX_POLYGONS=20 bash docker/run_NO_GJEN_002_canopy_height_model.sh
# ---------------------------------------------------------------------------
CHM_REGIONS="${CHM_REGIONS:-Vestlandet Sorlandet Nord-Norge Ostlandet Midt-Norge}"
CHM_MAX_POLYGONS="${CHM_MAX_POLYGONS:-0}"


# ===========================================================================
# NO_GJEN_002 national canopy-height map on GPU (docker/run_NO_GJEN_002_national_chm.sh)
# ===========================================================================

# ---------------------------------------------------------------------------
# NATIONAL_CHM_OUT_DIR - where the national canopy-height maps are written
# (one sub-folder per model, ~40-60 GB each). No default: set it in
# config.local.env. A folder on the network drive is fine; chunks are written
# locally first and copied when finished.
#
#   In config.local.env:   NATIONAL_CHM_OUT_DIR=/mnt/g/some/folder/national_chm_2025
# ---------------------------------------------------------------------------
NATIONAL_CHM_OUT_DIR="${NATIONAL_CHM_OUT_DIR:-}"


# ---------------------------------------------------------------------------
# NATIONAL_CHM_AR5 - the AR5 mire polygons the map covers. Default: the
# national mire layer NO_GJEN_001 uses (built with docker/prepare_ar5_input/).
# ---------------------------------------------------------------------------
NATIONAL_CHM_AR5="${NATIONAL_CHM_AR5:-${REPO_DIR:-.}/NO_GJEN_001/data/OpenS_data/ar5_myr_national.gpkg}"


# ---------------------------------------------------------------------------
# ORTHOPHOTO_FLIGHT_PROJECTS - which flight project (and year) is visible
# where in the orthophoto mosaic; NO_GJEN_002 dates every 20 m cell with it.
# Default: metadata/mosaic_coverage_by_project.gpkg next to the mosaic
# (delivered with it). Field PROJECT must end with the flight year.
# ---------------------------------------------------------------------------
ORTHOPHOTO_FLIGHT_PROJECTS="${ORTHOPHOTO_FLIGHT_PROJECTS:-}"


# ---------------------------------------------------------------------------
# CHM_COMPARISON_DIR - working folder of docker/run_NO_GJEN_002_chm_comparison.sh
# (CHMv1/CHMv2 against LiDAR; calibration and validation cells). Needs ~30 GB
# while it runs (the photo windows are deleted at the end). Keep it local.
#
#   In config.local.env:   CHM_COMPARISON_DIR=/data/chm_comparison
# ---------------------------------------------------------------------------
CHM_COMPARISON_DIR="${CHM_COMPARISON_DIR:-$RUNS_DIR/chm_comparison}"
