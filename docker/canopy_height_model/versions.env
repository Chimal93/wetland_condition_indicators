# Pinned versions for the canopy-height model image. Read by the
# Dockerfile (as build arguments, via docker/build_canopy_height_image.sh),
# update_requirements_lock.sh and download_model_and_weights.sh.

# Python. 3.9 is what Meta's README and upstream's run used; torch 2.0.1
# itself supports 3.8-3.11 and pytorch_lightning 1.7 up to 3.10.
PYTHON_VERSION=3.9.25

# uv, the tool that installs Python and the packages (Debian-based image), pinned by digest.
UV_IMAGE=ghcr.io/astral-sh/uv:0.12.21-trixie-slim@sha256:0b4686f3d71340b38a02d2b73b17620fe18d5c82c0f1c3c3a59996ed6e8e5b98

# Package resolution is frozen to what was published before this date.
EXCLUDE_NEWER=2026-10-01T00:00:00Z

# Meta's model code: github.com/facebookresearch/HighResCanopyHeight at
# this commit (the latest on 2026-10-01, dated 2025-04-10).
MODEL_CODE_COMMIT=84971392fb3a017e53d19e28ee0409d0de5d5d61
