# Example of docker/config.local.env - YOUR machine-specific settings.
#
# How to use: copy this file to docker/config.local.env (same folder, without
# ".example"), then keep only the lines you want to change and edit their
# values. Everything that is not in your file keeps its default from
# docker/config.env, where every setting is explained.
#
# docker/config.local.env is ignored by git, so your paths never end up in
# the repository. Lines starting with "#" are comments.

# Where run output goes (logs, versions, result snapshots, download caches).
# Default: the folder "runs" inside the repository.
RUNS_DIR=/data/wetland_runs

# Use the public AR50 map for VAAT-GJEN-01 because you do not have FKB-AR5.
# Default: AR5.
VAAT_GJEN_01_SOURCE=AR50

# Only run these indicators by default. Default: VAAT-FUNC-01 VAAT-CONN-01 VAAT-GJEN-02 VAAT-NDVI-01 VAAT-GJEN-01.
INDICATORS="VAAT-FUNC-01 VAAT-CONN-01"
