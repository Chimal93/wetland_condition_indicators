# Machine-specific settings for the Docker runner (see docker/config.env)
docker/config.local.env

# R session files
.Rhistory
.RData
.Rproj.user/

# R output artifacts from interactive sessions - never intentional output.
# Intermediate data and caches inside the indicator folders are ignored by
# each indicator's own .gitignore.
Rplots.pdf
*.Rout

# Output of the Docker runner (logs, recorded versions, result snapshots,
# download caches) - see docker/README.md. Change the place with RUNS_DIR.
runs/

# Canopy heights computed by docker/run_NO_GJEN_002_canopy_height_model.sh,
# one folder per CHM_RUN_NAME with its provenance. Not committed by default:
# they derive from licensed imagery. Commit a finished run deliberately, as
# upstream did with meta_chm_national_RAW_2026-09-17/.
NO_GJEN_002/data/OpenS_data/canopy_height_runs/

# Download logs and the AR5 source-file list describe the local copies of
# the data (which are not committed either) - see "Where the data came
# from" in docker/README.md. Each run's data_sources.csv in runs/ is the
# copy to keep or share.
NO_*/data/data_sources_log.csv
NO_GJEN_001/data/OpenS_data/ar5_national_source_files.csv
